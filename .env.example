# ==============================================================================
# Azist Take-Home Project: Data Ether
# Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Required - get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional defaults provided)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# PostgreSQL Database Connection String (Amazon RDS PostgreSQL or local)
# Format: postgresql://[user]:[password]@[host]:5432/[database]
DATABASE_URL=postgresql://postgres:your_password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/azist_db

# Enable SSL for remote cloud databases like AWS RDS (set to "true" for RDS)
DB_SSL=true

# Security, Caching & Rate Limiting Controls
AI_TIME_BUDGET_MS=30000
RATE_LIMIT_PER_MIN=5
DAILY_AI_CAP=150
CACHE_TTL_HOURS=6
